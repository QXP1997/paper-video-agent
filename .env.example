# Copy this file to .env and replace the placeholder with your own key.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# TTS (Edge TTS)
PAPER_VIDEO_TTS_VOICE=zh-CN-XiaoxiaoNeural
PAPER_VIDEO_TTS_RATE=+0%
PAPER_VIDEO_TTS_PITCH=+0Hz

# Parallelism (reduce these values on low-memory machines)
PAPER_VIDEO_TTS_CONCURRENCY=4
PAPER_VIDEO_VIDEO_CONCURRENCY=3

# Optional CJK font settings for FFmpeg.
# Windows usually detects Microsoft YaHei automatically. On macOS/Linux,
# set either an installed font family name or an absolute font file path.
PAPER_VIDEO_FONT_NAME=
PAPER_VIDEO_FONT_PATH=
